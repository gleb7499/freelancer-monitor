{
  "name": "freelancer-monitor",
  "private": true,
  "type": "module",
  "devDependencies": {
    "wrangler": "^4",
    "typescript": "^5",
    "@cloudflare/workers-types": "^5"
  },
  "scripts": {
    "gen:rules": "node scripts/gen-rules.mjs",
    "pretypecheck": "npm run gen:rules",
    "predeploy": "npm run gen:rules",
    "typecheck": "tsc --noEmit",
    "acceptance": "esbuild scripts/acceptance.ts --bundle --platform=node --format=esm --loader:.md=text --outfile=node_modules/.cache/acceptance.mjs --log-level=warning && node node_modules/.cache/acceptance.mjs",
    "deploy": "wrangler deploy"
  }
}
